#: __main__.py:34
msgid "<<< Welcome to Python-MUD 0.1 >>>"
msgstr "<<< Добро пожаловать в Python-MUD 0.1 >>>"

#: __main__.py:55
msgid "Incorrect name of the monster. It does not exists"
msgstr "Невеное имя монстра. Оно не существует"

#: __main__.py:62
msgid "Something wrong with hello string when trying to parse it to a monster"
msgstr ""
"Что-то не так с фразой монстра при попытке распарсить её и закрепить за "
"монстром"

#: __main__.py:70
msgid "hp argument should be a positive integer"
msgstr "Очки здоровья должны быть положительным целым числом"

#: __main__.py:77
msgid "Something wrong with coords when trying to parse it to a monster"
msgstr ""
"Что-то не так с координатами монстра при попытке их распарсить и "
"закрепить за монстром"

#: __main__.py:87
msgid "Smth wrong with this command"
msgstr "Что-то не так с этой командой"

#: __main__.py:106
msgid "Incorrect mode"
msgstr "Неверный режим"

#: __main__.py:118
msgid "Choose another locale"
msgstr "Выберите другую локаль"

#: __main__.py:124
msgid "Invalid input. You should provide at least name of the monster to attack"
msgstr "Неверный ввод. Вам необходимо предоставить хотя бы имя монстра для атаки"

#: __main__.py:133
msgid "Unknown weapon"
msgstr "Неизвестный вид оружия"

#: __main__.py:169
msgid "You should input your message to others"
msgstr "Необходимо ввести сообщение всем игрокам"

#: __main__.py:236
msgid "All commands from file are done. Logout"
msgstr "Все команды из файла выполнены. Выход"

#: __main__.py:242
msgid "This login is already assigned"
msgstr "Этот логин уже занят"

